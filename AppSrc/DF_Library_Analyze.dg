        End_Object
        
        Object oArray_CJGridColumn is a LA_cCJGridColumn
          Set piWidth to 58
          Set psCaption to "Array"
          Set pbVisible to False
        End_Object

        Procedure doFill_with_Data
          tLibAnalyzerOutput stLibAnalyzerOutput 
          tLibAnalyzerDependencyIssue[] staLibAnalyzerDependencyIssue  
          tDataSourceRow[] staDataSourceRows
          
          Boolean bRead_Json_file
          Integer iArray_Count
          Integer icCount
          Integer iIdentical  
          Integer iArray_Count_Candidates          
          Integer icCount_Candidates
          
          Get pbRead_Json_file to bRead_Json_file
          
          If (bRead_Json_file) Begin
            Get pstLibAnalyzerOutput to stLibAnalyzerOutput            
            Move stLibAnalyzerOutput.errors to staLibAnalyzerDependencyIssue
            
            Move (SizeOfArray (staLibAnalyzerDependencyIssue)) to iArray_Count
            
            For icCount from 0 to (iArray_Count - 1)
              Move staLibAnalyzerDependencyIssue[icCount].description to staDataSourceRows[icCount].sValue[0]
              Move staLibAnalyzerDependencyIssue[icCount].workspace   to staDataSourceRows[icCount].sValue[1]
              Move icCount                                            to staDataSourceRows[icCount].sValue[2]
            Loop
          End
          
          Send InitializeData staDataSourceRows          
        End_Procedure
        
        Procedure OnRowChanged Integer iOldRow Integer iNewSelectedRow  
          Boolean bRead_Json_file
          Handle  hoErrors_Related_Workspace_CJGrid
          Integer iArray 
          
          Get pbRead_Json_file to bRead_Json_file
          
          If (bRead_Json_file) Begin
            Get phoErrors_Related_Workspace_CJGrid to hoErrors_Related_Workspace_CJGrid
            
            If (hoErrors_Related_Workspace_CJGrid > 0) Begin
              Get RowValue of oArray_CJGridColumn iNewSelectedRow to iArray    
              
              Send doFill_with_Data of oErrors_Related_Workspace_CJGrid iArray
              Send doFill_with_Data of oErrors_Impacted_Files_CJGrid    iArray
              Send doFill_with_Data of oErrors_Referenced_Files_CJGrid  iArray
              Send doFill_with_Data of oErrors_Suggestions_CJGrid       iArray
            End
          End
        End_Procedure

        Procedure OnCreate
          Forward Send OnCreate 
          
          Send doFill_with_Data
        End_Procedure
    
      End_Object

      Object oErrors_Related_Workspace_CJGrid is a LA_cCJGrid
        Set Location to 5 414
        Set Size to 58 402
        Set peAnchors to anTopLeftRight
        Set pbAllowAppendRow to False
        Set pbAllowDeleteRow to False
        Set pbAllowInsertRow to False
        Set pbAutoAppend to False        
        Set pbAllowColumnRemove to False
        Set pbAllowColumnReorder to False

        Object oRelated_Workspace_CJGridColumn is a LA_cCJGridColumn
          Set piWidth to 333
          Set psCaption to "Related Workspaces"
          Set pbEditable to False
        End_Object

        Procedure doFill_with_Data Integer iArray
          tLibAnalyzerOutput stLibAnalyzerOutput         
          String[] saRelatedWorkspaces
          tDataSourceRow[] staDataSourceRows
          
          Boolean bRead_Json_file
