  Object oAll_Results_TabDialog is a LA_cTabDialog
    Set Location to 65 4
    Set Size to 416 827
    Set peAnchors to anAll

    Object oDependency_Tree_TabPage is a TabPage
      Set Label to 'Dependency Tree'

      Object oDependency_Tree is a LA_cTreeView
        Set Location to 5 5
        Set Size to 386 402
        Set peAnchors to anAll

        Object oImageList is a cImageList32
          Set piMaxImages to 6

          Procedure OnCreate // add the images
            Integer iImage

            Get AddTransparentImage 'Dataflex.bmp'  clFuchsia to iImage    // 0
            Get AddTransparentImage 'Library.bmp'   clFuchsia to iImage    // 1
            Get AddTransparentImage 'Ambiguous.bmp' clFuchsia to iImage    // 2      
            Get AddTransparentImage 'Conflict.bmp'  clFuchsia to iImage    // 3
            Get AddTransparentImage 'Reverse.bmp'   clFuchsia to iImage    // 4
            Get AddTransparentImage 'missing.bmp'   clFuchsia to iImage    // 5
          End_Procedure

        End_Object   
        
        Set ImageListObject   to (oImageList (Self))
            
        Procedure doAdd_Dependency tLibAnalyzerDependencyNode stLibAnalyzerDependencyNode Handle hoParent
          Integer iArray_Count
          Integer icCount
          Handle  hHandle 
          Handle  hVoid
          
          Get AddTreeItem stLibAnalyzerDependencyNode.name hoParent 0 1 1 to hHandle
          
          Move (SizeOfArray (stLibAnalyzerDependencyNode.dependencies)) to iArray_Count
          If (iArray_Count > 0) Begin   
            For icCount from 0 to (iArray_Count - 1)
              Send doAdd_Dependency stLibAnalyzerDependencyNode.dependencies[icCount] hHandle
            Loop
          End   
          
          Move (SizeOfArray (stLibAnalyzerDependencyNode.ambiguousUse)) to iArray_Count
          If (iArray_Count > 0) Begin
            For icCount from 0 to (iArray_Count - 1)
              Get AddTreeItem ("Ambiguous use - " + stLibAnalyzerDependencyNode.ambiguousUse[icCount]) hHandle 0 2 2 to hVoid
            Loop
          End
          
          Move (SizeOfArray (stLibAnalyzerDependencyNode.conflictingUse)) to iArray_Count
          If (iArray_Count > 0) Begin
            For icCount from 0 to (iArray_Count - 1)
              Get AddTreeItem ("Conflicting File Resolution - " + stLibAnalyzerDependencyNode.conflictingUse[icCount]) hHandle 0 3 3 to hVoid
            Loop
          End

          Move (SizeOfArray (stLibAnalyzerDependencyNode.ReverseUse)) to iArray_Count
          If (iArray_Count > 0) Begin
            For icCount from 0 to (iArray_Count - 1)
              Get AddTreeItem ("Reverse Use References - " + stLibAnalyzerDependencyNode.reverseUse[icCount]) hHandle 0 4 4 to hVoid
            Loop
          End

          Move (SizeOfArray (stLibAnalyzerDependencyNode.missingDependencies)) to iArray_Count
          If (iArray_Count > 0) Begin
            For icCount from 0 to (iArray_Count - 1)
              Get AddTreeItem ("Missing - " + stLibAnalyzerDependencyNode.missingDependencies[icCount]) hHandle 0 5 5 to hVoid
            Loop
          End
        End_Procedure
      
        Procedure OnCreateTree 
          tLibAnalyzerOutput         stLibAnalyzerOutput             
          tLibAnalyzerDependencyNode stLibAnalyzerDependencyNode           
          
          Integer iArray_Count
          Integer icCount
          
          Handle  hRoot  
          
          Get pstLibAnalyzerOutput to stLibAnalyzerOutput
          
          Move stLibAnalyzerOutput.tree to stLibAnalyzerDependencyNode  
          
          Send ClearAll
          Set CurrentTreeItem to hRoot
          Get AddTreeItem stLibAnalyzerDependencyNode.name hRoot 0 0 0 to hRoot  
          
          Move (SizeOfArray (stLibAnalyzerDependencyNode.dependencies)) to iArray_Count
          If (iArray_Count) Begin  
            For icCount from 0 to (iArray_Count - 1)
              Send doAdd_Dependency stLibAnalyzerDependencyNode.dependencies[icCount] hRoot
            Loop
           
            // Add tree items here, via AddTreeItem:
            // Get AddTreeItem sText hRoot iItemData iImage iSelImage to hItem
          End   
          Send DoExpandAll hRoot     
          Set CurrentTreeItem to hRoot
        End_Procedure
      
      End_Object  
      
    End_Object

    Object oConflict_in_Files_TabPage is a TabPage
      Set Label to "Conflict in files"

      Object oFile_CJGrid is a LA_cCJGrid
        Set Location to 5 5
        Set Size to 367 269
        Set peAnchors to anTopBottomLeft 
        Set pbAllowAppendRow to False
        Set pbAllowDeleteRow to False
        Set pbAllowInsertRow to False
        Set pbAutoAppend to False        
        Set pbAllowColumnRemove to False
        Set pbAllowColumnReorder to False

        Object oFile_CJGridColumn is a LA_cCJGridColumn
          Set piWidth to 326
          Set psCaption to "File"
          Set pbEditable to False
        End_Object

        Object oDifferent_CJGridColumn is a LA_cCJGridColumn
          Set piWidth to 64
          Set psCaption to "Different"
          Set pbCheckbox to True
          Set pbEditable to False
        End_Object
      
        Object oCount_CJGridColumn is a LA_cCJGridColumn
          Set piWidth to 58
          Set psCaption to "Count"
          Set peTextAlignment to xtpAlignmentCenter
          Set pbEditable to False
        End_Object
        
        Object oArray_CJGridColumn is a LA_cCJGridColumn
          Set piWidth to 58
          Set psCaption to "Array"
          Set pbVisible to False
        End_Object

        Procedure doFill_with_Data
          tLibAnalyzerOutput stLibAnalyzerOutput 
          tLibAnalyzerConflictingFile[] staLibAnalyzerConflictingFile  
          tDataSourceRow[] staDataSourceRows
          
          Integer iArray_Count
          Integer icCount
          Integer iIdentical  
          Integer iArray_Count_Candidates          
          Integer icCount_Candidates
          
          Get pstLibAnalyzerOutput to stLibAnalyzerOutput            
          Move stLibAnalyzerOutput.conflictingFiles to staLibAnalyzerConflictingFile
          
          Move (SizeOfArray (staLibAnalyzerConflictingFile)) to iArray_Count
          
          For icCount from 0 to (iArray_Count - 1)
            Move staLibAnalyzerConflictingFile[icCount].name to staDataSourceRows[icCount].sValue[0]
            Move 0 to iIdentical   
            Move (SizeOfArray (staLibAnalyzerConflictingFile[icCount].candidates)) to iArray_Count_Candidates
            For icCount_Candidates from 0 to (iArray_Count_Candidates -1)
              Move (iIdentical + staLibAnalyzerConflictingFile[icCount].candidates[icCount_Candidates].group) to iIdentical 
            Loop                                                                                                           
            If (iIdentical > 0) Begin
              Move True                  to staDataSourceRows[icCount].sValue[1]
            End
            Else Begin
              Move False                 to staDataSourceRows[icCount].sValue[1]
            End
            Move iArray_Count_Candidates to staDataSourceRows[icCount].sValue[2]
            Move icCount                 to staDataSourceRows[icCount].sValue[3]
          Loop

          Send InitializeData staDataSourceRows          
        End_Procedure
        
        Procedure OnRowChanged Integer iOldRow Integer iNewSelectedRow  
          Handle  hoConflicts_CJGrid  
          Integer iArray 
          
          Get phoConflicts_CJGrid to hoConflicts_CJGrid
          
          If (hoConflicts_CJGrid > 0) Begin
            Get RowValue of oArray_CJGridColumn iNewSelectedRow to iArray
            Send doFill_with_Data of oConflicts_CJGrid iArray
          End
        End_Procedure

        Procedure OnCreate
          Forward Send OnCreate 
          
          Send doFill_with_Data
        End_Procedure
    
      End_Object

      Object oConflicts_CJGrid is a LA_cCJGrid
        Property Integer[] piMerge
        
        Set Location to 5 288
        Set Size to 367 529
        Set peAnchors to anAll
        Set pbAllowAppendRow to False
        Set pbAllowDeleteRow to False
        Set pbAllowInsertRow to False
        Set pbAutoAppend to False
        Set pbAllowColumnRemove to False
        Set pbAllowColumnReorder to False
        
        Procedure doProcess_Selection Boolean bSelected
          Integer[] iMerge                      
          tDataSourceRow[] staDatasourceRows
          
          Handle hoDataSource                   
          
          Boolean bPro_Edition
          Integer iMax_Merges 
          Integer iArray_Count  
          Integer iFirst_Merge   
          Integer iLocation  
          Integer iRow       
          
          Get pbPro_Edition of ghoApplication to bPro_Edition
          
          If (bPro_Edition) Begin
            Move 3 to iMax_Merges
          End                    
          Else Begin
            Move 2 to iMax_Merges
          End
          
          Get pimerge to iMerge 
          
          Get pstaDataSourceRows to staDatasourceRows
          
          Get piSelectedRow to iRow
          
          Move (SizeOfArray (iMerge)) to iArray_Count

          If (bSelected) Begin
            If (iArray_Count = iMax_Merges) Begin
              Move iMerge[0] to iFirst_Merge
              
    
              Move False to staDatasourceRows[iFirst_Merge].sValue[0]
              Move True  to staDatasourceRows[iRow].sValue[0]
              
              Move (RemoveFromArray (iMerge, 0)) to iMerge
              Move iRow to iMerge[-1]
              
              Send ReInitializeData staDatasourceRows True
            End  
            Else Begin
              Move iRow to iMerge[-1]
            End
          End
          Else Begin
            Move (SearchArray (iRow, iMerge)) to iLocation
            Move (RemoveFromArray (iMerge, iLocation)) to iMerge
          End
          
          Set piMerge to iMerge
        End_Procedure

        Object oSelect_CJGridColumn is a LA_cCJGridColumn
          Set piWidth to 34
          Set psCaption to "Select"     
          Set pbCheckbox to True

          Procedure OnSelectedRowDataChanged String sOldValue String sValue
            Forward Send OnSelectedRowDataChanged sOldValue sValue    
            
            Send doProcess_Selection (sValue = 1)
          End_Procedure
          
        End_Object

        Object oWorkspace is a LA_cCJGridColumn
          Set piWidth to 229
          Set psCaption to "Workspace"
          Set pbEditable to False
        End_Object

        Object oPath_and_File is a LA_cCJGridColumn
          Set piWidth to 436
          Set psCaption to "Path and File"
          Set pbEditable to False
        End_Object 
        
        Object oSize is a LA_cCJGridColumn
          Set piWidth to 71
          Set psCaption to "Size"
          Set peDataType to Mask_Numeric_Window
          Set pbEditable to False
          Set psMask to "#0."
        End_Object 
        
        Object oModified is a LA_cCJGridColumn
          Set piWidth to 112
          Set psCaption to "Modified"
          Set peDataType to Mask_Datetime_Window   
          Set pbEditable to False
        End_Object 
        
        Procedure doFill_with_Data Integer iArray
          tLibAnalyzerOutput stLibAnalyzerOutput 
          tLibAnalyzerConflictingFileCandidate[] staLibAnalyzerConflictingFileCandidate
          tDataSourceRow[] staDataSourceRows                    
          Integer[] iMerge
          
          Boolean bRead_Json_file
          Integer iArray_Count
          Integer icCount    
          Handle  hoFileSystem                      
          Integer iSize       
          
          Date    dDate
          Integer iHour
          Integer iMinute
          Integer iSecond            
          DateTime dtFile
          
          
          Get pbRead_Json_file to bRead_Json_file
          
          If (bRead_Json_file) Begin
            Get pstLibAnalyzerOutput to stLibAnalyzerOutput            
          
            Move stLibAnalyzerOutput.conflictingFiles[iArray].candidates to staLibAnalyzerConflictingFileCandidate
            Move (SizeOfArray (staLibAnalyzerConflictingFileCandidate)) to iArray_Count
            
            Get Create (RefClass (cFilesystem)) to hoFileSystem
            
            For icCount from 0 to (iArray_Count - 1)
              Move False                                                        to staDataSourceRows[icCount].sValue[0]      
              
              Move staLibAnalyzerConflictingFileCandidate[icCount].workspace    to staDataSourceRows[icCount].sValue[1] 
              Move staLibAnalyzerConflictingFileCandidate[icCount].path         to staDataSourceRows[icCount].sValue[2] 
              //
              // PHvW 04/10/2026 Next line give GPF in 64 bits, Not area of expertice. So just run it in 32 bits
              //
              Get FileSize of hoFileSystem staDataSourceRows[icCount].sValue[2] to staDataSourceRows[icCount].sValue[3]          
              Get_File_Mod_Time staDataSourceRows[icCount].sValue[2]            to dDate iHour iMinute iSecond        
              
              Move dDate to dtFile
              Move (DateAddHour   (dtFile, iHour))   to dtFile
              Move (DateAddMinute (dtFile, iMinute)) to dtFile
              Move (DateAddSecond (dtFile, iSecond)) to dtFile
              
              Move dtFile                                                       to staDataSourceRows[icCount].sValue[4]
              
            Loop
                      
            Send Destroy of hoFileSystem    
            
            Set piMerge to iMerge
          End
          
          Send InitializeData staDataSourceRows
        End_Procedure 
      
        Procedure OnCreate
          Integer iArray_Value
          
          Forward Send OnCreate  
          
          Set phoConflicts_CJGrid to Self
          
          Send doFill_with_Data 0
        End_Procedure
      
      End_Object

      Object oMerge_Button is a LA_cButton
        Set Location to 379 767
        Set Label to "Merge Tool"
        Set peAnchors to anBottomRight
      
        Procedure OnClick                           
          Integer[] iMerge                          
          tDataSourceRow[] staDataSourceRows
          String[] saFiles
          
          Handle hoDataSource                   
          String  sApplicatiun           
          Integer iArray_Count       
          Integer icCount
          String  sFile                                           
          String  sProgram
          String  sCommand_line
          
          Get piMerge of oConflicts_CJGrid to iMerge  
          Move (SizeOfArray (iMerge)) to iArray_Count
          
          If (iArray_Count > 1) Begin
            Get pstaDataSourceRows of oConflicts_CJGrid to staDatasourceRows
            
            Move '"C:\Program Files\Araxis\Araxis Merge\Merge.exe "' to sProgram
            For icCount from 0 to (iArray_Count - 1)
              Move staDataSourceRows[iMerge[icCount]].sValue[2] to sFile
              Move (sCommand_line + ' "' + sFile + '"') to sCommand_line 
            Loop
            
            Runprogram Background sProgram sCommand_line
          End
        End_Procedure
      
      End_Object
      
    End_Object

    Object oErrors_TabPage is a TabPage
      Set Label to 'Errors'

      Object oErrors_CJGrid is a LA_cCJGrid
        Set Location to 5 5
        Set Size to 386 402
        Set peAnchors to anTopBottomLeft
        Set pbAllowAppendRow to False
        Set pbAllowDeleteRow to False
        Set pbAllowInsertRow to False
