Object oDF_Library_Analyze is a LA_cModalPanel
  Property tLibAnalyzerOutput pstLibAnalyzerOutput
  
  Property Boolean pbRead_Json_file
  
  Property Handle  phoConflicts_CJGrid  
  Property Handle  phoErrors_Related_Workspace_CJGrid    
  Property Handle  phoWarnings_Related_Workspace_CJGrid
  

  Set Border_Style to Border_Thick
  Set Size to 503 836
  Set Location to 4 2
  Set Label to "DF Library Analyze"      
  Set Icon to "DfLibAnalyzer.ico"
  Set piMinSize to 503 836
  Set piMaxSize to 1000 1200   
  Set Locate_Mode to Center_On_Screen
  
  Procedure Page_Object Boolean bPage
    Forward Send Page_Object bPage
    If (bPage) Begin
      Set Icon to "DfLibAnalyzer.ico"
    End
  End_Procedure   

  Procedure doOpen_in_Editor_Explorer String sPath_File
    tSettings stSettings 
    
    String  sCommand_Line
    
    Get pstSettings of ghoApplication to stSettings   
    
    If (stSettings.sEditor_or_Explorer = "Open file in Selected Editor") Begin
      If (stSettings.sEditor_Location <> "") Begin
        Move ('"' + stSettings.sEditor_Location + '" "' + sPath_File + '"') to sCommand_Line   
      End               
    End
    Else Begin
      //
      // PHvW 15/09/2026 Other option open file in windows explorer 
      // 
      // way to do it: %SYSTEMROOT%\explorer.exe /select,path_file_name 
      //
      Move ('"' + 'c:\Windows\explorer.exe' + '" ' + '/select,' + '"' + sPath_File + '"') to sCommand_Line
    End
    
    Runprogram Background sCommand_Line
  End_Procedure

