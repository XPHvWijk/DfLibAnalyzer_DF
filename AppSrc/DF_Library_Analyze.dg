    Object oProcess_Button is a LA_cButton
      Set Location to 33 490
      Set Label to "Process"    
      Set psToolTip to "Generates the json file through the dflibanalyzer. And will fill all information."
    
      Procedure OnClick   
        tLibAnalyzerOutput stLibAnalyzerOutput
        tSettings stSettings
        
        Boolean bFileExists
        String  sCommand_Line
        String  sCommand_Line_Parameters  
        String  sWorking_Dir         
        Integer iVoid
        
        Get pstSettings of ghoApplication to stSettings 
        
        If (stSettings.sLib_Analyzer = "") Begin
          Send Info_Box "Please enter in Setting the path en file to the DfLibAnalyzer.exe" "Pleaee Note"
          
          Procedure_Return
        End
        Else Begin
          File_Exist stSettings.sLib_Analyzer bFileExists
          
          If (bFileExists = False) Begin
            Send Info_Box "The DfLibAnalyzer.exe cannot be found in Current location in Settings" "Pleaee Note"
            
            Procedure_Return
          End
        End  
        
        If (stSettings.sLast_Workspace = "") Begin
          Send Info_Box "Please enter a workspace" "Pleaee Note"
          
          Procedure_Return
        End
        Else Begin
          File_Exist stSettings.sLast_Workspace bFileExists
          
          If (bFileExists = False) Begin
            Send Info_Box "The workspace.sws annot be found in Current location given" "Pleaee Note"
            
            Procedure_Return
          End
        End  
        
        //
        // PHvW 30/08/2026 Now we make the parameter String       // 1.0.1	dflibanalyzer.exe "F:\Data\HRp5\V-60\HRp5.V-60d - 26.0.sws" -v > text_1_0_7.txt
        //
        Move (sCommand_Line + '"' + stSettings.sLib_Analyzer + '" ') to sCommand_Line  
        //Move (sCommand_Line + "%windir%\system32\cmd.exe ") to sCommand_Line  
        //Move ('"' + stSettings.sLib_Analyzer + '" ') to sCommand_Line_Parameters
        If (stSettings.sAdditional_Extensions <> "") Begin
          Move (sCommand_Line_Parameters + "--extensions " + stSettings.sAdditional_Extensions + " ") to sCommand_Line_Parameters
        End
        If (stSettings.bLast_Verbose) Begin
          Move (sCommand_Line_Parameters + "-v ") to sCommand_Line_Parameters
        End
        If (stSettings.bLast_Recursive) Begin
          Move (sCommand_Line_Parameters + "-r ") to sCommand_Line_Parameters
        End     
        If ((stSettings.bScan_Images) and (stSettings.sBitmap_Extensions <> "")) Begin
          Move (sCommand_Line_Parameters + "--scan-bitmap-path ")                                 to sCommand_Line_Parameters   
          Move (sCommand_Line_Parameters + "--extensions " + stSettings.sBitmap_Extensions + " ") to sCommand_Line_Parameters
        End     
        
        Move (sCommand_Line_Parameters + '"'   + stSettings.sLast_Workspace + '" ') to sCommand_Line_Parameters

        Move (sCommand_Line_Parameters + "--json ") to sCommand_Line_Parameters
        
        Move (sCommand_Line_Parameters + '"' + stSettings.sLast_Json_File + '"')  to sCommand_Line_Parameters
        
        Runprogram Wait sCommand_Line sCommand_Line_Parameters     
        
        File_Exist stSettings.sLast_Json_File bFileExists
        
        If (bFileExists) Begin
          Get giveLibAnalyzerOutput stSettings.sLast_Json_File to stLibAnalyzerOutput 
        
          Set pstLibAnalyzerOutput to stLibAnalyzerOutput
          Set pbRead_Json_file     to True
        
          Send doFill_with_the_JSON        
        End
        Else Begin
          Set pbRead_Json_file     to False
        End
      End_Procedure
                                                                   
    End_Object  

