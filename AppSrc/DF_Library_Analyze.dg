  Object oClose_Button is a LA_cButton
    Set Location to 485 395
    Set Label to 'Close'
    Set peAnchors to anBottomRight
  
    //
    // PHvW 30/08/2026 Lets Save the last settings
    //
    Procedure OnClick   
      tSettings stSettings                   
      
      Handle  hoObject  
      
      Get pstSettings of ghoApplication to stSettings
      
      Get Create (RefClass (cSettings_Read_Write)) to hoObject
      Send doWrite_Settings of hoObject "Settings.json" stSettings
      Set pstSettings of ghoApplication to stSettings
      Send Destroy of hoObject      
      
      Abort
    End_Procedure
  
  End_Object

  Procedure doFill_with_the_JSON
    Send OnCreateTree of oDependency_Tree
  End_Procedure        
  
  Procedure doJSON_Parse                      
    tLibAnalyzerOutput stLibAnalyzerOutput
    
    String  sPathFIle
    
    Get Value of oJSON_Output_File_Form to sPathFIle
    Get giveLibAnalyzerOutput sPathFIle to stLibAnalyzerOutput 
    
    Set pstLibAnalyzerOutput to stLibAnalyzerOutput
    Set pbRead_Json_file     to True
    
    Send doFill_with_the_JSON    
  End_Procedure   
  
  On_Key Key_Ctrl+Key_J Send doJSON_Parse  
  
  Procedure Activating
    tSettings stSettings
    
    Forward Send Activating
    
    Get pstSettings of ghoApplication to stSettings  
    
    Set Value of oWorkspace_Form        to stSettings.sLast_Workspace
    Set Value of oJSON_Output_File_Form to stSettings.sLast_Json_File
  End_Procedure

End_Object
