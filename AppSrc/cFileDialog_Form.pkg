  Function GiveLocalFileName String path_file_name Returns String
    Integer stop
    String result   
    
    Move (Integer (False)) to stop
    
    Repeat
      If (Pos ("\", path_file_name) > 0) Begin
        Move (Right (path_file_name, (LENGTH (path_file_name) - Pos ("\", path_file_name)))) to path_file_name
      End
      Else Begin
        Move (Integer (True)) to stop
      End
    Until stop

    Function_Return path_file_name
  End_Function

  Procedure prompt
    String sValue
    Boolean bWithPathName

    If (Show_Dialog(phoFileDialog(Self))) Begin
      Get File_Name of (phoFileDialog (Self)) to sValue
      Get pbWithPathName to bWithPathName
      If (bWithPathName) Begin
      End
      Else Begin
        Get GiveLocalFileName sValue to sValue
      End
      Set value to sValue
    End
  End_Procedure
  
End_Class