Use LA_cForm.pkg

Class cFileDialog_Form is a LA_cForm
  
  Procedure construct_object
    Forward Send construct_object

    Set prompt_button_mode to True

    { Visibility=Private }
    Property Integer phoFileDialog        0
    { Category="LA-Framework" }                                  
    { PropertyType=Boolean }
    Property Integer pbWithPathName       True

    Object FileDialog is an OpenDialog
      Delegate Set phoFileDialog to Self

      Set Filter_String   to "Text Files|*.txt|All Files|*.*"
      Set File_Title      to ""
      Set Dialog_Caption  to "Select a file" 

    End_Object 

  End_Procedure 

  Procedure End_Construct_Object
    Forward Send End_Construct_Object

  End_Procedure

  { MethodType=Property }
  { Category="LA-Framework" }
  { InitialValue="Text Files|*.txt|All Files|*.*" }
  Procedure Set Filter_String String sValue
    Set Filter_String of (phoFileDialog (Self)) to sValue
  End_Procedure

  Function Filter_String Returns String
    String sValue

    Get Filter_String of (phoFileDialog (Self)) to sValue

    Function_Return sValue
  End_Function

  { MethodType=Property }
  { Category="LA-Framework" }
  Procedure Set Initial_Folder String sValue
    Set Initial_Folder of (phoFileDialog (Self)) to sValue
  End_Procedure

